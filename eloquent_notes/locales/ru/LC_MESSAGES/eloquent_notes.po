msgstr "Ошибка обработки диктовки: {detail}"

msgid "Failed to load user configuration: {error}\n\nLoaded default settings."
msgstr "Не удалось загрузить пользовательскую конфигурацию: {error}\n\nЗагружены настройки по умолчанию."

msgid "Failed to reload configuration: {error}"
msgstr "Не удалось перезагрузить конфигурацию: {error}"

