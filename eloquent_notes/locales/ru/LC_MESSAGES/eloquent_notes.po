msgstr "Ошибка конфигурации"

msgid "Configuration reloaded successfully."
msgstr "Конфигурация успешно перезагружена."

msgid "Configuration section '{key}' must be a mapping, got {type_name}"
msgstr "Раздел конфигурации '{key}' должен быть словарём, получено {type_name}"

msgid "Connection failed: {error}"
msgstr "Ошибка подключения: {error}"

msgid "Context Length:"
msgstr "Длина контекста:"

msgid "Context length in tokens to pass to Ollama. Larger values allow longer dictations but use more memory."
msgstr "Длина контекста в токенах, передаваемая в Ollama. Большие значения позволяют обрабатывать более длинные диктовки, но требуют больше памяти."

msgid "Copy"
msgstr "Копировать"

msgid "Could not move {name} to the trash."
msgstr "Не удалось переместить {name} в корзину."

msgid "Could not start recording: {error}"
msgstr "Не удалось начать запись: {error}"

msgid "Could not stop recording: {error}"
msgstr "Не удалось остановить запись: {error}"

msgid "Creates a desktop autostart entry in the XDG autostart directory"
msgstr "Создаёт запись автозапуска в каталоге автозапуска XDG"

msgid "Decision"
msgstr "Решение"

