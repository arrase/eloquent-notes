msgid "Command to execute: 'install-autostart', 'toggle', 'open' (show the notes window), or 'config' (open configuration GUI)."
msgstr "Команда для выполнения: 'install-autostart', 'toggle', 'open' (показать окно заметок) или 'config' (открыть окно настроек)."

msgid "Configuration"
msgstr "Конфигурация"

