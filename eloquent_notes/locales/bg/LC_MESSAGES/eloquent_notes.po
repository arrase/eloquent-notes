msgstr "Класификация – Потребителски промпт"

msgid "Command to execute: 'install-autostart', 'toggle', 'open' (show the notes window), or 'config' (open configuration GUI)."
msgstr "Команда за изпълнение: 'install-autostart', 'toggle', 'open' (показва прозореца с бележки) или 'config' (отваря настройките)."

msgid "Configuration"
msgstr "Конфигурация"

msgid "Configuration Error"
msgstr "Грешка в конфигурацията"

msgid "Configuration reloaded successfully."
msgstr "Конфигурацията е презаредена успешно."

msgid "Configuration section '{key}' must be a mapping, got {type_name}"
msgstr "Конфигурационната секция '{key}' трябва да бъде речник, получено е {type_name}"

msgid "Connection failed: {error}"
msgstr "Неуспешно свързване: {error}"

msgid "Context Length:"
msgstr "Дължина на контекста:"

msgid "Context length in tokens to pass to Ollama. Larger values allow longer dictations but use more memory."
msgstr "Дължина на контекста в токени, подавана към Ollama. По-големите стойности позволяват по-дълги диктовки, но използват повече памет."

msgid "Copy"
msgstr "Копирай"

msgid "Could not move {name} to the trash."
msgstr "Неуспешно преместване на {name} в кошчето."

msgid "Could not start recording: {error}"
msgstr "Неуспешно стартиране на записа: {error}"

msgid "Could not stop recording: {error}"
msgstr "Неуспешно спиране на записа: {error}"

msgid "Creates a desktop autostart entry in the XDG autostart directory"
msgstr "Създава запис за автоматично стартиране в директорията XDG autostart"

msgid "Decision"
msgstr "Решение"

msgid "Decisions"
msgstr "Решения"

msgid "Defaults restored. Click 'Save' to apply changes to disk."
msgstr "Стойностите по подразбиране са възстановени. Щракнете върху „Запази“, за да запишете промените на диска."

msgid "Delete"
msgstr "Изтрий"

