msgstr "Eloquent Notes (Обработка...)"

msgid "Eloquent Notes (Recording...)"
msgstr "Eloquent Notes (Записване...)"

msgid "Eloquent Notes - Linux system tray utility that turns offline voice dictations into organized notes."
msgstr "Eloquent Notes – Приложение за системния трей на Linux, което превръща офлайн гласови диктовки в организирани бележки."

msgid "Eloquent Notes Configuration"
msgstr "Конфигурация на Eloquent Notes"

msgid "Eloquent Notes Daemon"
msgstr "Фонов процес на Eloquent Notes"

msgid "Embedding Model cannot be empty."
msgstr "Моделът за вграждане (embedding) не може да бъде празен."

msgid "Embedding Model:"
msgstr "Модел за вграждане:"

msgid "Error processing dictation: {detail}"
msgstr "Грешка при обработка на диктовката: {detail}"

msgid "Failed to load user configuration: {error}\n\nLoaded default settings."
msgstr "Неуспешно зареждане на потребителската конфигурация: {error}\n\nЗаредени са настройките по подразбиране."

msgid "Failed to reload configuration: {error}"
msgstr "Неуспешно презареждане на конфигурацията: {error}"

