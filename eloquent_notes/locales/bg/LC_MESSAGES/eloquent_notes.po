msgstr "Общи"

msgid "Idea"
msgstr "Идея"

msgid "Ideas"
msgstr "Идеи"

msgid "If checked, sets context_length to null (or leaves it unset), instructing Ollama to use the model's default maximum context length."
msgstr "Ако е отметнато, задава context_length на null (или го оставя незададено), указвайки на Ollama да използва максималната дължина на контекста по подразбиране за модела."

msgid "Invalid Keep Alive format: '{value}'. Must be an integer or duration (e.g., 5m, 10s, 1h, 0, -1)."
msgstr "Невалиден формат за Keep Alive: '{value}'. Трябва да е цяло число или продължителност (напр. 5m, 10s, 1h, 0, -1)."

msgid "Invalid Preload Keep Alive format: '{value}'. Must be an integer or duration (e.g., 5m, 10s, 1h, 0, -1)."
msgstr "Невалиден формат за Preload Keep Alive: '{value}'. Трябва да е цяло число или продължителност (напр. 5m, 10s, 1h, 0, -1)."

msgid "Invalid Search Keep Alive format: '{value}'. Must be an integer or duration (e.g., 5m, 10s, 1h, 0, -1)."
msgstr "Невалиден формат за Search Keep Alive: '{value}'. Трябва да е цяло число или продължителност (напр. 5m, 10s, 1h, 0, -1)."

msgid "Invalid configuration value for '{key}'"
